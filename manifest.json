{
  "name": "CPH Submit (Fresh)",
  "manifest_version": 3,
  "version": "0.1.0",
  "description": "Auto-submit Codeforces solutions from Competitive Programming Helper",
  "permissions": [
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:27121/*",
    "https://codeforces.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://codeforces.com/*/submit*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
